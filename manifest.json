{
  "manifest_version": 3,
  "name": "Solstice",
  "short_name": "Solstice",
  "version": "1.0.20",
  "description": "Solstice utilities for GOLDEN HOUR and Potato Epic.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Toggle Solstice ClickGUI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/toy/golden-hour/index.html"
      ],
      "js": [
        "extension/protocol.js",
        "extension/controller.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.bilibili.com/toy/golden-hour/index.html"
      ],
      "css": [
        "extension/overlay.css"
      ],
      "js": [
        "extension/boot.js",
        "js/core.js",
        "modules/Combat/AimBot.js",
        "modules/Combat/TriggerBot.js",
        "modules/Combat/NoRecoil.js",
        "modules/Combat/Aura.js",
        "modules/Movement/Sprint.js",
        "modules/Movement/NoJumpDelay.js",
        "modules/Player/AntiAim.js",
        "modules/Visual/Watermark.js",
        "modules/Visual/ThirdPerson.js",
        "modules/Visual/ClickGui.js",
        "modules/Visual/Interface.js",
        "modules/Visual/HudEditor.js",
        "modules/Visual/Arraylist.js",
        "modules/Visual/ESP.js",
        "modules/Visual/Keystrokes.js",
        "modules/Visual/Notifications.js",
        "modules/Misc/ToggleSounds.js",
        "modules/Misc/UIDSpoof.js",
        "modules/Misc/CustomServer.js",
        "modules/Misc/UnLock.js",
        "modules/Misc/AutoDodge.js",
        "modules/Misc/KillSound.js",
        "modules/Visual/BulletTracers.js",
        "modules/Combat/CrouchShot.js",
        "js/main.js",
        "js/commands.js",
        "extension/page.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.bilibilitoy.com/toy/golden-hour/*"
      ],
      "js": [
        "extension/game-key-bridge.js",
        "modules/Misc/UIDSpoof.js",
        "modules/Misc/CustomServer.js",
        "modules/Combat/AimBot.js",
        "modules/Combat/TriggerBot.js",
        "modules/Combat/NoRecoil.js",
        "modules/Combat/Aura.js",
        "modules/Movement/Sprint.js",
        "modules/Movement/NoJumpDelay.js",
        "modules/Player/AntiAim.js",
        "modules/Visual/ESP.js",
        "modules/Misc/UnLock.js",
        "modules/Visual/ThirdPerson.js",
        "modules/Misc/AutoDodge.js",
        "modules/Misc/KillSound.js",
        "modules/Visual/BulletTracers.js",
        "modules/Combat/CrouchShot.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.bilibili.com/toy/potatoepic/index.html"
      ],
      "js": [
        "extension/protocol.js",
        "extension/controller.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.bilibili.com/toy/potatoepic/index.html"
      ],
      "css": [
        "extension/overlay.css"
      ],
      "js": [
        "extension/boot.js",
        "js/core.js",
        "modules/Visual/ClickGui.js",
        "modules/Visual/Interface.js",
        "modules/Visual/Arraylist.js",
        "modules/Visual/Watermark.js",
        "modules/Visual/Notifications.js",
        "modules/Visual/HudEditor.js",
        "modules/Misc/ToggleSounds.js",
        "modules/Visual/ESP.js",
        "modules/Combat/AimBot.js",
        "modules/Combat/TriggerBot.js",
        "modules/Combat/NoRecoil.js",
        "modules/Misc/KillSound.js",
        "modules/Combat/Aura.js",
        "modules/Combat/InfAmmo.js",
        "modules/Combat/FastShot.js",
        "modules/Misc/UIDSpoof.js",
        "modules/Misc/UnLock.js",
        "modules/Movement/Speed.js",
        "modules/Movement/FastStop.js",
        "modules/Player/GodMode.js",
        "js/main.js",
        "js/commands.js",
        "extension/page.js"
      ],
      "run_at": "document_start",
      "all_frames": false,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.bilibilitoy.com/toy/potatoepic/*"
      ],
      "js": [
        "extension/potato-key-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.bilibilitoy.com/toy/potatoepic/*"
      ],
      "js": [
        "extension/potato-game-bridge.js",
        "modules/Visual/ESP.js",
        "modules/Combat/AimBot.js",
        "modules/Combat/TriggerBot.js",
        "modules/Combat/NoRecoil.js",
        "modules/Misc/KillSound.js",
        "modules/Combat/Aura.js",
        "modules/Combat/InfAmmo.js",
        "modules/Combat/FastShot.js",
        "modules/Misc/UIDSpoof.js",
        "modules/Misc/UnLock.js",
        "modules/Movement/Speed.js",
        "modules/Movement/FastStop.js",
        "modules/Player/GodMode.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/fonts/*",
        "assets/audio/*",
        "assets/img/seven_days.png"
      ],
      "matches": [
        "https://www.bilibili.com/*"
      ]
    }
  ]
}
